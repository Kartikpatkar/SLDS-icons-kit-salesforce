{
    "name": "Icons Kit for Salesforce Developer",
    "description": "Browse, preview, customize, and copy Salesforce SLDS icons.",
    "version": "1.1.0",
    "manifest_version": 3,
    "action": {
        "default_title": "Icons Kit for Salesforce Developer",
        "default_icon": {
            "16": "assets/extension-icons/icon16.png",
            "32": "assets/extension-icons/icon32.png",
            "48": "assets/extension-icons/icon48.png",
            "128": "assets/extension-icons/icon128.png"
        }
    },
    "icons": {
        "16": "assets/extension-icons/icon16.png",
        "32": "assets/extension-icons/icon32.png",
        "48": "assets/extension-icons/icon48.png",
        "128": "assets/extension-icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [],
    "host_permissions": [],
    "web_accessible_resources": [{
        "resources": [
            "assets/icons/**/*", 
            "icons-index.json",
            "libs/monaco/vs/base/worker/workerMain.js",
            "libs/monaco/vs/editor/editor.worker.js",
            "libs/monaco/vs/language/json/json.worker.js"
        ],
        "matches": ["<all_urls>"]
    }]
}